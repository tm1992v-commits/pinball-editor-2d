; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pinball Editor 2D"
config/description="Pinball Editor 2D: editor e motore dei flipper 2D."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.03, 0.03, 0.04, 1)
boot_splash/show_image=false
config/icon="res://interfaccia/icona/icona.png"

[autoload]

Parametri="*res://motore/parametri.gd"
Audio="*res://motore/audio.gd"
Comandi="*res://motore/comandi.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[filesystem]

import/blender/enabled=false

[input_devices]

sensors/enable_accelerometer=true

[physics]

common/physics_ticks_per_second=240
2d/default_gravity=950.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.03, 0.03, 0.04, 1)
